{
  "name": "procwatch",
  "version": "1.2.1",
  "license": "MIT",
  "description": "A fully offline desktop app for Linux that tracks application usage and productivity",
  "author": {
    "name": "Ishtiaq Khan",
    "email": "ishtiaqkhan@example.com"
  },
  "main": "backend/src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "node -e \"console.log('No build step needed for JS backend')\"",
    "build": "npm run build:frontend",
    "start": "npx electron backend/src/main.js",
    "dev": "npx electron backend/src/main.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "test": "npm test --workspace=backend",
    "pack": "npm run build && npx electron-builder --dir",
    "dist": "npm run build && npx electron-builder"
  },
  "build": {
    "electronVersion": "33.4.11",
    "appId": "com.procwatch.app",
    "productName": "ProcWatch",
    "directories": {
      "output": "release"
    },
    "files": [
      "backend/src/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/src/db/migrations.sql",
        "to": "migrations.sql"
      },
      {
        "from": "backend/src/db/migration_v2.sql",
        "to": "migration_v2.sql"
      },
      {
        "from": "backend/src/db/migration_v3.sql",
        "to": "migration_v3.sql"
      },
      {
        "from": "frontend/assets/icon",
        "to": "assets/icon"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "frontend/assets/icon",
      "synopsis": "Offline Linux application time and productivity tracker"
    },
    "deb": {
      "packageName": "procwatch",
      "depends": [
        "xdotool",
        "wmctrl",
        "x11-utils"
      ]
    },
    "asar": true
  },
  "dependencies": {
    "active-win": "^7.0.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "electron-builder": "^26.0.0"
  }
}
